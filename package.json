{
  "name": "madrid-mystery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create madrid-mystery-db",
    "db:migrate:local": "wrangler d1 migrations apply madrid-mystery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply madrid-mystery-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.46.0"
  }
}
